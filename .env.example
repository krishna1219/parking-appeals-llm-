# Pick ONE option, fill it in, and save this file as .env (never commit .env)

# --- Option 1: Google Gemini free tier (run with: --provider openai --delay 7) ---
OPENAI_API_KEY=your-gemini-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash

# --- Option 2: Ollama on your own laptop, free and offline (run with: --provider openai) ---
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# --- Option 3: Anthropic, paid (run with: --provider anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-your-key-here
